# Checking out on Windows rewrote the executable scripts in api/bin to CRLF,
# which the Linux container reads as a shebang of `ruby\r` — every rails and
# rspec invocation printed
#   /usr/bin/env: 'ruby\r': No such file or directory
# before falling through to the bundler binstub. Pinning LF keeps the repo
# usable from Windows hosts against Linux containers.
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.ico  binary
