# Optional overrides for .devcontainer/docker-compose.yml.
# Copy to .devcontainer/.env (gitignored) and fill in real values as needed.
# Everything here has a working default for local dev without this file.

GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001
GEMINI_FLASH_MODEL=gemini-2.0-flash-001
GEMINI_PRO_MODEL=gemini-2.0-pro-001

# Only override if you need tokens to be verifiable outside this devcontainer.
SECRET_KEY_BASE=
