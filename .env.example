# Docker Compose reads this file as .env (copy it; .env is gitignored). All three are required.
# Use letters and digits only: the Redis password goes into a URL.

# Local dev database. Postgres applies it when the pgdata volume is first created; to change it later, either
# `docker compose down -v` (wipes the dev database) or ALTER USER postgres PASSWORD '...' and update this value.
POSTGRES_PASSWORD=

# Local Redis (Sidekiq, the coverage channel, rate limits).
REDIS_PASSWORD=

# Sign-in for the dev admin, admin@example.com, created by db/seeds.rb. Seeding again resets it to this value.
DEV_ADMIN_PASSWORD=
