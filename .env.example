# Copy to .env and fill in. `.env` is gitignored — never commit real keys.
#
#   cp .env.example .env

# Google AI Studio key. Leave blank to run the deterministic paths only;
# the model-backed paths degrade to their fallbacks (which is itself worth
# exercising — see the fit/gap fallback narrative tests).
GEMINI_API_KEY=

# Model ids.
#
# These go stale, and the failure is confusing: the API returns 404 with
# "no longer available to new users", the client raises, and the fit/gap
# engine quietly falls back to its mechanical narrative. The report still
# renders, so it looks like a content problem rather than a config one.
#
# api/config/application.yml.sample and api/README.md already disagree with
# each other about which ids to use, and at the time of writing neither set
# resolves for a newly issued key.
#
# Check what your key can actually reach before assuming these work:
#
#   curl -s -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1/models \
#     | grep -o '"name": "models/[^"]*"'
#
# Note that a model appearing in that list is not sufficient — some are
# listed but refused for new keys. The 404 body names its replacement.
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001
GEMINI_FLASH_MODEL=gemini-3.6-flash
GEMINI_PRO_MODEL=gemini-3.7-flash

# Local dev defaults — safe to leave as-is.
SECRET_KEY_BASE=dev_only_secret_key_base_not_for_production
DB_NAME=rakamin_development
DB_USERNAME=postgres
DB_PASSWORD=postgres
APP_BASE_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:5173
TOKEN_EXPIRATION_TIME=259200
