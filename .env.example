# Database Configuration
# DB_PASSWORD - Set this in your local .env file
# DB_USERNAME - Set this in your local .env file
# DB_NAME - Set this in your local .env file

# Rails Configuration
# SECRET_KEY_BASE - Generate with: bundle exec rails secret

# Gemini API (optional)
# GEMINI_API_KEY - Get from Google AI Studio
GEMINI_LIVE_MODEL=gemini-2.0-flash-live-001
GEMINI_FLASH_MODEL=gemini-2.0-flash-001
GEMINI_PRO_MODEL=gemini-2.0-pro-001

# Frontend Configuration
# VITE_DEV_TOKEN - Get from rails console after seeding
VITE_DEV_TENANT_ID=1
VITE_DEV_TENANT_NAME=Demo Tenant