  <tr><td style="padding: 4px 12px; font-weight: bold;">Candidate</td><td style="padding: 4px 12px;"><%= @candidate %></td></tr>
  <tr><td style="padding: 4px 12px; font-weight: bold;">Status</td><td style="padding: 4px 12px;"><%= @session.status %></td></tr>
  <tr><td style="padding: 4px 12px; font-weight: bold;">End Reason</td><td style="padding: 4px 12px;"><%= @session.end_reason %></td></tr>
