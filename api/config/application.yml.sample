# Copy this to config/application.yml and fill in your values.
# This file is loaded by Figaro and values become ENV vars.

# Shared with rakamin-api — must match exactly for JWT to work
SECRET_KEY_BASE: "your_secret_key_base_here"

# Database (shared with rakamin-api)
DB_HOST: "localhost"
DB_PORT: "5432"
DB_NAME: "rakamin_development"
DB_USERNAME: "postgres"
DB_PASSWORD: ""

# AI Interview specific
GEMINI_API_KEY: "your_gemini_api_key"

# Model ids move. Check what your key can actually reach before assuming:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$KEY"
#
# The gemini-2.0-* ids this file used to name are retired and now 404.
#
# GEMINI_PRO_MODEL points at a flash model on purpose: the AI Studio free tier
# grants no quota for any Pro model, so portfolio generation answers 429 with a
# free key. Point it back at a Pro id if yours is billed.
GEMINI_LIVE_MODEL: "gemini-3.1-flash-live-preview"
GEMINI_FLASH_MODEL: "gemini-2.5-flash"
GEMINI_PRO_MODEL: "gemini-2.5-flash"

# App URL (for invite links)
APP_BASE_URL: "http://localhost:3001"
# Frontend URL — used to build candidate invite links
WEB_BASE_URL: "http://localhost:5173"

# Token settings (should match rakamin-api)
TOKEN_EXPIRATION_TIME: "259200"  # 3 days in seconds

# CORS
ALLOWED_ORIGINS: "*"

# Sidekiq / Redis
REDIS_URL: "redis://localhost:6379/1"
