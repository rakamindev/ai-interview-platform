# Copy this to config/application.yml and fill in your values.
# This file is loaded by Figaro and values become ENV vars.

# Shared with rakamin-api — must match exactly for JWT to work
SECRET_KEY_BASE: "your_secret_key_base_here"

# Database (shared with rakamin-api)
DB_HOST: "localhost"
DB_PORT: "5432"
DB_NAME: "rakamin_development"
DB_USERNAME: "postgres"
DB_PASSWORD: ""

# AI Interview specific
# GEMINI_FLASH_MODEL / GEMINI_PRO_MODEL: verified working against the
# generateContent REST API as of this writing. The previous gemini-2.0-*
# defaults have been retired by Google (404 Not Found).
# GEMINI_LIVE_MODEL: a separate model family (Live/bidi API) — NOT verified
# in this change; check it independently before relying on it.
GEMINI_API_KEY: "your_gemini_api_key"
GEMINI_LIVE_MODEL: "gemini-2.0-flash-live-001"
GEMINI_FLASH_MODEL: "gemini-3.8-flash"
GEMINI_PRO_MODEL: "gemini-3.8-flash"

# This API's own base URL
APP_BASE_URL: "http://localhost:3001"

# The web app's base URL — used to build candidate invite links.
# This is a DIFFERENT origin from APP_BASE_URL in every real deployment
# (see web/vercel.json vs api/k8s/ingress.yml).
WEB_BASE_URL: "http://localhost:5173"

# Token settings (should match rakamin-api)
TOKEN_EXPIRATION_TIME: "259200"  # 3 days in seconds

# CORS
ALLOWED_ORIGINS: "*"

# Sidekiq / Redis
REDIS_URL: "redis://localhost:6379/1"
