# Copy this to config/application.yml and fill in your values.
# This file is loaded by Figaro and values become ENV vars.

# Shared with rakamin-api — must match exactly for JWT to work (mandatory, fails fast if missing)
SECRET_KEY_BASE: "your_secret_key_base_minimum_64_bytes_securely_generated"

# Database (shared with rakamin-api)
DB_HOST: "localhost"
DB_PORT: "5432"
DB_NAME: "rakamin_development"
DB_USERNAME: "postgres"
DB_PASSWORD: ""
DB_POOL: "16"

# Google Gemini AI Models
GEMINI_API_KEY: "your_gemini_api_key_here"
GEMINI_LIVE_MODEL: "gemini-3.1-flash-live-preview"
GEMINI_FLASH_MODEL: "gemini-2.5-flash"
GEMINI_PRO_MODEL: "gemini-3.1-pro-preview"

# Frontend Web App URL (for candidate interview invite links)
APP_BASE_URL: "http://localhost:5173"

# Token settings (should match rakamin-api)
TOKEN_EXPIRATION_TIME: "259200"  # 3 days in seconds

# CORS
ALLOWED_ORIGINS: "http://localhost:5173,http://localhost:3000,*"

# Sidekiq / Redis
REDIS_URL: "redis://localhost:6379/1"
