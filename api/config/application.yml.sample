# Copy this to config/application.yml and fill in your values.
# This file is loaded by Figaro and values become ENV vars.

# Shared with rakamin-api — must match exactly for JWT to work
SECRET_KEY_BASE: "your_secret_key_base_here"

# Database (shared with rakamin-api)
DB_HOST: "localhost"
DB_PORT: "5432"
DB_NAME: "rakamin_development"
DB_USERNAME: "postgres"
DB_PASSWORD: ""

# AI Interview specific
GEMINI_API_KEY: "your_gemini_api_key"
# Google retires model IDs; list the ones your key can use with:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models
GEMINI_LIVE_MODEL: "gemini-3.1-flash-live-preview"
GEMINI_FLASH_MODEL: "gemini-3.5-flash"
# Writes the post-interview portfolio. Free-tier keys have no Pro quota, so Flash is the default.
GEMINI_PRO_MODEL: "gemini-3.5-flash"

# Web app URL — candidate invite links point here (/interview/:token is a frontend route)
FRONTEND_BASE_URL: "http://localhost:5173"

# Token settings (should match rakamin-api)
TOKEN_EXPIRATION_TIME: "259200"  # 3 days in seconds

# CORS
ALLOWED_ORIGINS: "*"

# Sidekiq / Redis
REDIS_URL: "redis://localhost:6379/1"
