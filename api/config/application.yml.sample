# Copy this to config/application.yml and fill in your values.
# This file is loaded by Figaro and values become ENV vars.

# Shared with rakamin-api — must match exactly for JWT to work
SECRET_KEY_BASE: "your_secret_key_base_here"

# Database (shared with rakamin-api)
DB_HOST: "localhost"
DB_PORT: "5432"
DB_NAME: "rakamin_development"
DB_USERNAME: "postgres"
DB_PASSWORD: ""

# AI Interview specific
GEMINI_API_KEY: "your_gemini_api_key"
# Set GEMINI_STUB to "true" to run without a key (fixture-backed responses).
# Compose already sets this; only needed for native (non-container) runs.
# GEMINI_STUB: "false"
# GEMINI_STUB_MODE: "valid"   # see app/clients/gemini/stub_client.rb
GEMINI_LIVE_MODEL: "gemini-3.1-flash-live-preview"
GEMINI_FLASH_MODEL: "gemini-3.5-flash"
GEMINI_PRO_MODEL: "gemini-3.5-flash"

# App URL (for invite links)
APP_BASE_URL: "http://localhost:3001"
WEB_BASE_URL: "http://localhost:5173"

# Token settings (should match rakamin-api)
TOKEN_EXPIRATION_TIME: "259200"  # 3 days in seconds

# CORS — must NOT be "*" when credentials: true (browsers reject it per Fetch spec).
ALLOWED_ORIGINS: "http://localhost:5173"

# Sidekiq / Redis
REDIS_URL: "redis://localhost:6379/1"

# Native (non-container) `RAILS_ENV=test` runs otherwise inherit DB_NAME from
# the top-level default above and truncate the real development database via
# DatabaseCleaner (see rails_helper.rb) — this override keeps test runs on
# their own database.
test:
  DB_NAME: "rakamin_test"
  # Docker-compose sets this for container test runs; native runs need it
  # too so specs never make real Gemini API calls (see spec comments in
  # portfolio_generator_worker_spec.rb and Gemini::ClientFactory).
  GEMINI_STUB: "true"
