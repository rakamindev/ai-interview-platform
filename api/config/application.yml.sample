# Copy this to config/application.yml and fill in your values.
# This file is loaded by Figaro and values become ENV vars.

# Shared with rakamin-api — must match exactly for JWT to work
SECRET_KEY_BASE: "your_secret_key_base_here"

# Database (shared with rakamin-api)
DB_HOST: "localhost"
DB_PORT: "5432"
DB_NAME: "rakamin_development"
DB_USERNAME: "postgres"
DB_PASSWORD: ""

# AI Interview specific
GEMINI_API_KEY: "your_gemini_api_key"
GEMINI_LIVE_MODEL: "gemini-2.0-flash-live-001"
GEMINI_FLASH_MODEL: "gemini-2.5-flash"
GEMINI_PRO_MODEL: "gemini-2.0-pro-001"

# Public candidate web origin used in shareable invite links.
CANDIDATE_APP_URL: "http://localhost:5173"

# Token settings (should match rakamin-api)
TOKEN_EXPIRATION_TIME: "259200"  # 3 days in seconds

# CORS
ALLOWED_ORIGINS: "*"

# Sidekiq / Redis
# The Sidekiq and publisher instance must run with `maxmemory-policy noeviction`:
# nothing may evict a queue entry or a published coverage update.
REDIS_URL: "redis://localhost:6379/1"

# Cache and throttle counters. Falls back to REDIS_URL locally so development
# keeps a single instance. Point this at its own instance in any deployment that
# sets a maxmemory policy: `maxmemory-policy allkeys-lru` with an explicit
# `maxmemory` keeps the cache bounded without being able to evict Sidekiq keys.
REDIS_CACHE_URL: ""
