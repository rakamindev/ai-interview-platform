#!/bin/sh
set -e

# Bind-mounted worktrees don't carry the image's pre-created runtime dirs.
mkdir -p tmp/pids tmp/cache tmp/sockets log

echo "== waiting for Postgres =="
until pg_isready -h "${DB_HOST:-postgres}" -p "${DB_PORT:-5432}" -U "${DB_USERNAME:-postgres}" >/dev/null 2>&1; do
  sleep 1
done

echo "== db:prepare =="
# db:prepare's own db:schema:load fast-path for a fresh DB doesn't reliably
# apply schema_search_path, scattering ai_interview tables into `public`
# (see lib/tasks/force_migrate.rake). db:create + db:force_migrate is
# idempotent the same way — safe on every boot.
flock tmp/db_prepare.lock -c "bundle exec rails db:create db:force_migrate"

echo "== db:prepare (test) =="
# Keeps rakamin_test present and migrated so `bundle exec rspec` never falls
# back to running against the dev database (see spec/rails_helper.rb).
flock tmp/db_prepare_test.lock -c "RAILS_ENV=test DB_NAME=rakamin_test bundle exec rails db:create db:force_migrate"

# Seed only when the database is empty. Idempotent: db:seed uses
# find_or_initialize, so a concurrent api/sidekiq double-run is safe.
if ! bundle exec rails runner 'exit(Organization.count.positive? ? 0 : 1)' >/dev/null 2>&1; then
  echo "== empty database — seeding =="
  bundle exec rails db:seed
fi

exec "$@"
