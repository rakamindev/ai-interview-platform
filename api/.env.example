# Copy this to api/.env and fill in your values.
# docker compose auto-loads .env in this directory for ${VAR} substitution
# in docker-compose.yml. Values here override the defaults baked into
# docker-compose.yml (container hostnames like `postgres`/`redis`).
# .env is gitignored — safe to put real secrets here.

RAILS_ENV=development

# Shared with rakamin-api — must match exactly for JWT to work
SECRET_KEY_BASE=compose-development-secret

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=rakamin_development
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis / Sidekiq
REDIS_URL=redis://redis:6379/1

# Gemini
# Set GEMINI_STUB=true to run without a real key — Gemini::HttpClient (used
# for fit/gap, portfolio, coverage analysis) is fixture-backed in that mode.
# NOTE: Gemini::LiveClient (realtime interview audio) is NOT stubbed and
# always needs a real GEMINI_API_KEY with Live API access, even when
# GEMINI_STUB=true — interviews will fail a few seconds after connecting
# without one.
GEMINI_STUB=true
GEMINI_STUB_MODE=valid
GEMINI_API_KEY=your_gemini_api_key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_FLASH_MODEL=gemini-3.5-flash
GEMINI_PRO_MODEL=gemini-3.5-flash

# App URLs (for invite links, CORS)
APP_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
