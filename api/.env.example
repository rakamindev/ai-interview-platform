# ==============================================================================
# AI Interview Platform - Backend Environment Configuration (.env.example)
# ==============================================================================
# Usage:
#   1. Copy to .env:                cp .env.example .env
#   2. Or copy to Figaro config:    cp .env.example config/application.yml
#
# CRITICAL NOTE:
# SECRET_KEY_BASE is mandatory. The application strictly validates this key
# and fails fast on boot or token operations if missing or blank (Review #3).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Security & JWT Authentication
# ------------------------------------------------------------------------------
# Minimum 64-byte secret key used for HMAC-SHA256 JWT signing and verification.
# Must match between the auth provider (rakamin-api) and this service.
SECRET_KEY_BASE=your_secret_key_base_minimum_64_bytes_securely_generated

# JWT expiration window in seconds (259200 = 72 hours / 3 days)
TOKEN_EXPIRATION_TIME=259200

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rakamin_development
DB_USERNAME=postgres
DB_PASSWORD=
DB_POOL=16

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Models & Credentials
# ------------------------------------------------------------------------------
# Google AI Studio API key (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Live bidirectional WebSocket audio model (used in AudioWebsocketMiddleware)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Fast structured extraction & narrative synthesis (FitGap::Engine & Coverage::Analyzer)
GEMINI_FLASH_MODEL=gemini-2.5-flash

# Deep reasoning model for end-of-session competency portfolio synthesis (Portfolios::Generator)
GEMINI_PRO_MODEL=gemini-3.1-pro-preview

# Proactive reconnection threshold for live audio WebSocket in seconds (default: 510s / ~8.5m)
PROACTIVE_RECONNECT_AFTER=510

# ------------------------------------------------------------------------------
# 4. Redis, Sidekiq & Rate Limiting (Rack::Attack)
# ------------------------------------------------------------------------------
# Redis connection URL for Sidekiq background jobs, audio transcript buffers, and rate limiting
REDIS_URL=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# 5. Server, Network & CORS Configuration
# ------------------------------------------------------------------------------
# Backend Puma HTTP/WebSocket server port (default: 3001)
PORT=3001
RAILS_ENV=development
RAILS_MAX_THREADS=16
WEB_CONCURRENCY=0

# Frontend web application base URL (used to generate candidate interview invite links)
APP_BASE_URL=http://localhost:5173

# Allowed CORS origins for browser HTTP and WebSocket connections (comma-separated or *)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,*
