# Application Environment Variables Template
# Copy this to .env (do not commit .env to version control)

# Rails Secret Key Base (generate via `rails secret`)
SECRET_KEY_BASE=your_secret_key_base_here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rakamin_development
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_FLASH_MODEL=gemini-2.0-flash
GEMINI_PRO_MODEL=gemini-2.0-flash

# Application URLs & Security
APP_BASE_URL=http://localhost:5174
WEB_APP_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000
TOKEN_EXPIRATION_TIME=259200
REDIS_URL=redis://localhost:6379/1
