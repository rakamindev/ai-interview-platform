# Template for the ai-interview-secrets Secret.
#
# Copy to secret.yaml, fill in real values, and apply:
#   cp k8s/secret.yaml.example k8s/secret.yaml
#   # edit values...
#   kubectl apply -f k8s/secret.yaml
#
# secret.yaml is gitignored — never commit real credentials.
# Prefer External Secrets / Secret Manager for production clusters.
apiVersion: v1
kind: Secret
metadata:
  name: ai-interview-secrets
  namespace: default
type: Opaque
stringData:
  SECRET_KEY_BASE: "replace-me-openssl-rand-hex-64"
  GEMINI_API_KEY: "replace-me"
  DB_USERNAME: "replace-me"
  DB_PASSWORD: "replace-me"
