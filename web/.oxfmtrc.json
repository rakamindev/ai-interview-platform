{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "none",
  "tabWidth": 2,
  "useTabs": false,
  "insertFinalNewline": true,
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "*.min.js"
  ]
}
