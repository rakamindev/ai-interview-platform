# Backend API base URL
VITE_API_BASE_URL=http://localhost:3001/api/v1

# WebSocket base URL (no /api/v1)
VITE_WS_BASE_URL=ws://localhost:3001

# Dev auth token — paste a JWT from your local backend (rails console: JsonWebToken.encode(...))
VITE_DEV_TOKEN=

# First-party local endpoints avoid making candidate checks depend on public test services.
VITE_SPEED_TEST_PING_URL=http://localhost:3001/api/v1/health
VITE_SPEED_TEST_UPLOAD_URL=http://localhost:3001/api/v1/speed_test

# Dev tenant context
VITE_DEV_TENANT_ID=1
VITE_DEV_TENANT_NAME=Demo Tenant
