# Backend API base URL
VITE_API_BASE_URL=http://localhost:3001/api/v1

# WebSocket base URL (no /api/v1) — API serves on 3001 (see api/config/puma.rb)
VITE_WS_BASE_URL=ws://localhost:3001

# Dev auth token — paste a JWT from your local backend (rails console: JsonWebToken.encode(...))
VITE_DEV_TOKEN=

# Speed test endpoints when set, used instead of Cloudflare public speed test
VITE_SPEED_TEST_PING_URL=
VITE_SPEED_TEST_UPLOAD_URL=

# Dev tenant context
VITE_DEV_TENANT_ID=1
VITE_DEV_TENANT_NAME=Demo Tenant