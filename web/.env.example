# ==============================================================================
# AI Interview Platform - Frontend Environment Configuration (.env.example)
# ==============================================================================
# Usage:
#   cp .env.example .env.local
#   # Or: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend API & WebSocket Endpoints
# ------------------------------------------------------------------------------
# Backend REST API base URL (Rails Puma server runs on port 3001 by default)
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Backend WebSocket server URL (used for live candidate audio streaming & coverage)
VITE_WS_BASE_URL=ws://localhost:3001

# ------------------------------------------------------------------------------
# 2. Local Development Authentication & Multi-Tenancy
# ------------------------------------------------------------------------------
# Dev auth token — paste a valid JWT for local admin/recruiter testing
# (Generate in Rails console: JsonWebToken.encode(user_id: 1, tenant_id: 1, role: 'admin'))
VITE_DEV_TOKEN=

# Default tenant context for multi-tenant isolation
VITE_DEV_TENANT_ID=1
VITE_DEV_TENANT_NAME=Demo Tenant

# ------------------------------------------------------------------------------
# 3. Hardware Check & Interview Preflight
# ------------------------------------------------------------------------------
# Set to "true" to enforce camera access check, or "false" for audio-only / bypass (default: false)
VITE_REQUIRE_CAMERA=false

# Optional custom speed test endpoints (leave blank to use external CDN/httpbin fallbacks)
VITE_SPEED_TEST_PING_URL=
VITE_SPEED_TEST_UPLOAD_URL=
