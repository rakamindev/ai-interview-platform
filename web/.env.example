# Backend API base URL — leave blank to auto-derive from the current subdomain
# (e.g. http://ai-interview.localhost:3001/api/v1). Set only to override.
# VITE_API_BASE_URL=

# WebSocket base URL (no /api/v1) — same rule as above.
# VITE_WS_BASE_URL=

# API port used when deriving the base URL from the subdomain.
# VITE_API_PORT=3001

# Speed test endpoints — when set, used instead of external services (leave blank to use external CDN/httpbin)
VITE_SPEED_TEST_PING_URL=
VITE_SPEED_TEST_UPLOAD_URL=
