# Backend API base URL
VITE_API_BASE_URL=http://localhost:3001/api/v1

# WebSocket base URL (no /api/v1)
VITE_WS_BASE_URL=ws://localhost:3001

# Dev auth token — OPTIONAL.
# Leave this blank and sign in through the login form with the account created by
# `rails db:seed` (assessor@test-corp.local / password123). Setting it bypasses
# the login screen entirely: getStoredToken() falls back to this value whenever
# localStorage is empty, so the app behaves as if you were already signed in.
# Never commit a real token — .gitignore covers .env and its backups.
VITE_DEV_TOKEN=

# Speed test endpoints — when set, used instead of external services (leave blank to use external CDN/httpbin)
VITE_SPEED_TEST_PING_URL=
VITE_SPEED_TEST_UPLOAD_URL=

# Dev tenant context
VITE_DEV_TENANT_ID=1
VITE_DEV_TENANT_NAME=Demo Tenant
