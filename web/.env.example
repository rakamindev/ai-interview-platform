# Backend API base URL
VITE_API_BASE_URL=http://localhost:3000/api/v1

# WebSocket base URL (no /api/v1)
VITE_WS_BASE_URL=ws://localhost:3000

# Dev auth token — paste a JWT from your local backend (rails console: JsonWebToken.encode(...))
# WARNING: while this is set, the app signs itself in and the login screen is
# unreachable. Leave it blank unless you are actively developing.
VITE_DEV_TOKEN=

# Speed test endpoints — optional. Leave blank: the hardware check then measures
# against this application's own API, which is the only setting that keeps a
# candidate's IP address away from hosts their consent notice never named.
# Override only when the media path terminates somewhere other than the API.
VITE_SPEED_TEST_PING_URL=
VITE_SPEED_TEST_UPLOAD_URL=

# Dev tenant context
VITE_DEV_TENANT_ID=1
VITE_DEV_TENANT_NAME=Demo Tenant
