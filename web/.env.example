# Backend API base URL
VITE_API_BASE_URL=http://localhost:3000/api/v1

# WebSocket base URL (no /api/v1)
VITE_WS_BASE_URL=ws://localhost:3000

# Dev auth token — paste a JWT from your local backend (rails console: JsonWebToken.encode(...))
VITE_DEV_TOKEN=

# Speed test endpoints — default to the platform's own backend (no third-party traffic, UU PDP).
# Override only with internal endpoints (e.g. a CDN in front of your own infrastructure).
VITE_SPEED_TEST_PING_URL=http://localhost:3000/api/v1/health
VITE_SPEED_TEST_UPLOAD_URL=http://localhost:3000/api/v1/speed_test
VITE_SPEED_TEST_DOWNLOAD_URL=http://localhost:3000/api/v1/speed_test?bytes=1048576

# Dev tenant context
VITE_DEV_TENANT_ID=1
VITE_DEV_TENANT_NAME=Demo Tenant
